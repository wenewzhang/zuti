#!/bin/sh
set -e

case "$1" in
    configure)
        # Create required directories
        mkdir -p /etc/zuti/certs /var/lib/zuti /var/log/zuti /.data/zuti

        # Copy db.sqlite to /.data/zuti/ if not exists
        if [ ! -f "/.data/zuti/db.sqlite" ]; then
            if [ -f "/usr/share/zuti/db/db.sqlite" ]; then
                cp /usr/share/zuti/db/db.sqlite /.data/zuti/db.sqlite
                chmod 640 /.data/zuti/db.sqlite
                chown root:root /.data/zuti/db.sqlite
            fi
        fi

        # Copy .env.example to /etc/zuti/.env if not exists
        if [ ! -f "/etc/zuti/.env" ]; then
            if [ -f "/etc/zuti/.env.example" ]; then
                cp /etc/zuti/.env.example /etc/zuti/.env
                chmod 640 /etc/zuti/.env
                chown root:root /etc/zuti/.env

                # Generate JWT_SECRET and replace placeholder
                JWT_SECRET=$(tr -dc 'a-zA-Z0-9' </dev/urandom | head -c 64)
                sed -i "s/your_secret_key_change_in_production/${JWT_SECRET}/g" /etc/zuti/.env
            fi
        fi

        # Generate SSL certificates if not exists
        if [ ! -f "/etc/zuti/certs/cert.pem" ] || [ ! -f "/etc/zuti/certs/key.pem" ]; then
            openssl genrsa -out /etc/zuti/certs/key.pem 2048 2>/dev/null
            openssl req -new -x509 -key /etc/zuti/certs/key.pem -out /etc/zuti/certs/cert.pem -days 3650 \
                -subj "/C=CN/ST=State/L=City/O=Zuti/CN=localhost" 2>/dev/null
            chmod 600 /etc/zuti/certs/key.pem
            chmod 644 /etc/zuti/certs/cert.pem
            chown root:root /etc/zuti/certs/key.pem /etc/zuti/certs/cert.pem
        fi

        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
